# Choose one LLM provider.
#
# Option A: OpenRouter
# If both OPENROUTER_API_KEY and OPENROUTER_MODEL_NAME are set,
# the app uses OpenRouter first.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL_NAME=google/gemini-3-flash-preview

# Option B: OpenAI
# Use this when you do not set OpenRouter variables.
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4.1-mini

# Optional demo controls
# DA_OPS_DEMO_SCENARIO=os_warning
# DA_OPS_DB_PATH=da_ops_demo.sqlite3
